#!/usr/bin/env bash

# Examples:
#   gp-socks
#   gp-socks 1080
#   gp-socks 1080 10.1.2.3
#   gp-socks 1080 10.1.2.3 1080

set -euo pipefail

local_port=${1-1080}
remote_host=${2-}
remote_port=${3-}

gp() {
	if [ "$remote_host" ]; then
		ssh "$remote_host" sh -l -c \" gp "$@" \"
	else
		command gp "$@"
	fi
}

gp connect
if [ "$remote_host" ]; then
	if [ "$remote_port" ]; then
		ncat -lk 127.0.0.1 "$local_port" -c "ncat $remote_host $remote_port" &
	else
		ssh -D "$local_port" -N -v "$remote_host" &
	fi
else
	brook socks5 -l 127.0.0.1:"$local_port" &
fi
trap 'kill -9 %1' SIGINT SIGTERM EXIT

while sleep 60; do
	status=$(gp status)
	if [ "$status" = "VPN is not connected." ]; then
		exit 1
	fi
done
