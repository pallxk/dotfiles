# https://ghostty.org/docs/config/reference

# https://ghostty.org/docs/config/reference#auto-update
auto-update = download

# The command to run, usually a shell. If this is not an absolute path, it'll be looked up in the PATH. If this is not set, a default will be looked up from your system. The rules for the default lookup are:
#   SHELL environment variable
#   passwd entry (user information)
# command = /opt/homebrew/bin/bash

copy-on-select = clipboard

font-size = 14

macos-option-as-alt = true
macos-titlebar-style = tabs

quick-terminal-animation-duration = 0

# https://ghostty.org/docs/config/reference#quick-terminal-autohide
quick-terminal-autohide = false

shell-integration-features = no-cursor

# https://iterm2colorschemes.com
theme = dark:Catppuccin Mocha,light:Catppuccin Latte


# For default and custom key bindings: `ghostty +list-keybinds`

keybind = global:alt+grave_accent=toggle_quick_terminal
